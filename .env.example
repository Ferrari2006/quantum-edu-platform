# DeepSeek uses an OpenAI-compatible chat-completions API.
DEEPSEEK_API_KEY=replace-with-your-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2

# Maximum total characters of retrieved context sent to the chat model.
RAG_MAX_CONTEXT_CHARS=12000

# Local development defaults to backend/data/platform.db.
# On a server, point this to a mounted database path or replace SQLite with Postgres.
QUANTUM_PLATFORM_DB=backend/data/platform.db
AUTH_TOKEN_TTL_DAYS=14
